<Window x:Class="StorageConnectionStabilityTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Storage Connection Stability Test v0.3.0-alpha"
        Height="760"
        Width="1200"
        MinHeight="650"
        MinWidth="1000">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="190"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="130"/>
        </Grid.RowDefinitions>

        <!-- BAŞLIK -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Storage Connection Stability Test"
                       FontSize="23"
                       FontWeight="Bold"/>

            <TextBlock x:Name="OsText"
                       Margin="0,5,0,0"
                       FontSize="13"/>
        </StackPanel>


        <!-- DİSKLER -->
        <DataGrid x:Name="DiskGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionChanged="DiskGrid_SelectionChanged"
                  CanUserResizeRows="False"
                  HeadersVisibility="Column"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Sürücü"
                                    Binding="{Binding DriveLetter}"
                                    Width="70"/>

                <DataGridTextColumn Header="Disk"
                                    Binding="{Binding DiskNumber}"
                                    Width="55"/>

                <DataGridTextColumn Header="Model"
                                    Binding="{Binding Model}"
                                    Width="230"/>

                <DataGridTextColumn Header="Kapasite"
                                    Binding="{Binding SizeText}"
                                    Width="100"/>

                <DataGridTextColumn Header="Arayüz"
                                    Binding="{Binding InterfaceType}"
                                    Width="100"/>

                <DataGridTextColumn Header="USB VID/PID"
                                    Binding="{Binding VidPid}"
                                    Width="120"/>

                <DataGridTextColumn Header="Cihaz"
                                    Binding="{Binding DeviceName}"
                                    Width="*"/>

            </DataGrid.Columns>

        </DataGrid>


        <!-- TEST AYARLARI -->
        <Grid Grid.Row="2" Margin="0,10,0,5">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="Test miktarı (GB):"
                       Margin="0,0,8,0"/>

            <TextBox x:Name="SizeBox"
                     Grid.Column="1"
                     Text="50"
                     Height="28"
                     VerticalContentAlignment="Center"/>

            <Button x:Name="StartButton"
                    Grid.Column="2"
                    Content="Yazma Testini Başlat"
                    Width="165"
                    Height="30"
                    Margin="15,0,5,0"
                    Click="StartButton_Click"/>

            <Button x:Name="StopButton"
                    Grid.Column="3"
                    Content="Testi Durdur"
                    Width="110"
                    Height="30"
                    IsEnabled="False"
                    Margin="5,0"
                    Click="StopButton_Click"/>

            <Button Grid.Column="4"
                    Content="Bilgileri Yenile"
                    Width="120"
                    Height="30"
                    Margin="5,0"
                    Click="Refresh_Click"/>

            <TextBlock Grid.Column="5"
                       x:Name="StatusText"
                       VerticalAlignment="Center"
                       Margin="15,0,0,0"
                       FontWeight="Bold"/>

        </Grid>


        <!-- PROGRESS -->
        <ProgressBar x:Name="TestProgress"
                     Grid.Row="3"
                     Height="20"
                     Minimum="0"
                     Maximum="100"
                     Margin="0,0,0,10"/>


        <!-- DETAY -->
        <GroupBox Grid.Row="4"
                  Header="Cihaz / Bağlantı Bilgileri"
                  Margin="0,0,0,10">

            <TextBox x:Name="DetailBox"
                     FontFamily="Consolas"
                     FontSize="13"
                     IsReadOnly="True"
                     TextWrapping="NoWrap"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"/>

        </GroupBox>


        <!-- KISA SONUÇ -->
        <GroupBox Grid.Row="5"
                  Header="Servis Formu İçin Kısa Sonuç">

            <TextBox x:Name="SummaryBox"
                     FontFamily="Consolas"
                     FontSize="13"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"/>

        </GroupBox>

    </Grid>

</Window>